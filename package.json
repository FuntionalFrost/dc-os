{
	"name": "dc-os",
	"description": "All-in-one diagnostic suite and reference portal for Data Center Technicians, Systems Administrators, and NOC Engineers.",
	"version": "1.0.0",
	"author": "FuntionalFrost",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/FuntionalFrost/dc-os.git"
	},
	"homepage": "https://funtionalfrost.github.io/dc-os/",
	"bugs": {
		"url": "https://github.com/FuntionalFrost/dc-os/issues"
	},
	"keywords": [
		"data-center",
		"sysadmin",
		"networking",
		"linux",
		"fiber-optics",
		"comptia",
		"terminal",
		"subnet-calculator",
		"sveltekit",
		"diagnostics"
	],
	"engines": {
		"node": ">=20.0.0",
		"pnpm": ">=9.0.0"
	},
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
